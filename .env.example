# Copy to .env (or set in docker-compose) and adjust.
#
# IMPORTANT — two prefixes (they are NOT interchangeable):
#   AGENT_*              → read by app/config.py on the HOST (blind eval, local pytest)
#   DIAGNOSTIC_AGENT_*   → set in the REPO-ROOT .env; Compose maps them to AGENT_*
#                          inside the diagnostic-agent container only
#   AWS_* / OPENAI_API_KEY → SDK credentials (host). In Compose use
#                          DIAGNOSTIC_AGENT_AWS_* so they don't collide with MinIO AWS_*.
#
# Putting DIAGNOSTIC_AGENT_CHAT_PROVIDER here does nothing for
# `python eval/run_blind_eval.py` — use AGENT_CHAT_PROVIDER instead.
# See diagnostic-agent/README.md → "DIAGNOSTIC_AGENT_* vs AGENT_*".

# --- Data sources (defaults assume the publishi-network Docker DNS names) ---
AGENT_PROMETHEUS_URL=http://prometheus:9090
AGENT_LOKI_URL=http://loki:3100
AGENT_GRAFANA_URL=http://grafana:3000
# Grafana service-account token (Editor on OSS DEV; Viewer + annotations:write on
# Enterprise). Leave empty to disable Grafana reads/annotations gracefully.
# Provision: python scripts/provision_diagnostic_grafana_token.py --write-env
AGENT_GRAFANA_TOKEN=

# --- LLM / embeddings (LangChain provider + model strings) ---
AGENT_CHAT_PROVIDER=ollama
AGENT_CHAT_MODEL=mistral:7b-instruct
AGENT_EMBED_PROVIDER=ollama
AGENT_EMBED_MODEL=nomic-embed-text
AGENT_LLM_TEMPERATURE=0.1
AGENT_CHAT_MODEL_KWARGS={"base_url":"http://ollama:11434"}
AGENT_EMBED_MODEL_KWARGS={"base_url":"http://ollama:11434"}

# OpenAI example (set OPENAI_API_KEY in the environment, not AGENT_-prefixed):
# AGENT_CHAT_PROVIDER=openai
# AGENT_CHAT_MODEL=gpt-4o-mini
# AGENT_EMBED_PROVIDER=openai
# AGENT_EMBED_MODEL=text-embedding-3-small

# Bedrock example (host offline eval — use AWS_* here, not DIAGNOSTIC_AGENT_AWS_*):
# AGENT_CHAT_PROVIDER=bedrock_converse
# AGENT_CHAT_MODEL=amazon.nova-micro-v1:0
# AGENT_EMBED_PROVIDER=bedrock
# AGENT_EMBED_MODEL=amazon.titan-embed-text-v2:0
# AGENT_CHAT_MODEL_KWARGS={"region_name":"us-east-1"}
# AGENT_EMBED_MODEL_KWARGS={"region_name":"us-east-1"}
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Blind eval (host: python eval/run_blind_eval.py) ---
# When true, offline eval injects runbook RAG into the prompt (same retrieval as
# the live agent). Default false = blind (logs only). CLI override: --rag
# EVAL_INCLUDE_RAG=false
# AGENT_RAG_ENABLED=true

# --- RAG ---
AGENT_RAG_ENABLED=true
AGENT_RAG_TOP_K=3

# --- Retrieval tuning ---
AGENT_LOKI_LOOKBACK_MINUTES=15
AGENT_LOKI_LIMIT=500
AGENT_METRICS_WINDOW=5m

# --- Delivery ---
AGENT_GRAFANA_ANNOTATIONS_ENABLED=true

# Diagnostic email (hypotheses) — separate from Alertmanager alert email.
AGENT_EMAIL_ENABLED=true
AGENT_EMAIL_TO=dev-alerts@localhost
AGENT_EMAIL_SUBJECT_PREFIX=publishi
AGENT_SMTP_HOST=mailpit
AGENT_SMTP_PORT=1025
AGENT_SMTP_FROM=diagnostic-agent@publishi.local
# AGENT_SMTP_USERNAME=
# AGENT_SMTP_PASSWORD=
# AGENT_SMTP_STARTTLS=false
